<Window x:Class="SoundSplit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SoundSplit.ViewModels"
        Title="SoundSplit" Width="520" Height="760" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Window.Resources>
        <!-- Small coloured dot + text used for every status line. -->
        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,1,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Good}">
                    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Caution}">
                    <Setter Property="Fill" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Bad}">
                    <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DeviceCard" DataType="{x:Type vm:DeviceItem}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" Margin="2,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource ToneDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Neutral}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}" Margin="12,0,0,0"
                                  AutomationProperties.Name="{Binding Name}" ToolTip="Play on this speaker" />
                    </Grid>

                    <!-- Controls appear when the speaker is switched on, like an expanded Settings card. -->
                    <StackPanel Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleMute}" HorizontalAlignment="Left" Margin="-4,0,0,0"
                                    ToolTip="Mute or unmute" AutomationProperties.Name="Mute">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding VolumeGlyph}" />
                            </Button>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True" AutomationProperties.Name="Volume" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Body}" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Visibility="{Binding CanTrim, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"
                              ToolTip="Fine-tune by ear: right plays this speaker later, left earlier. Double-click the value to reset.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" Margin="4,0,0,0" HorizontalAlignment="Left" />
                            <Slider Grid.Column="1" Minimum="-300" Maximum="300" Value="{Binding TrimMs}" VerticalAlignment="Center"
                                    SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" AutomationProperties.Name="Timing" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Body}" Text="{Binding TrimText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Background="Transparent">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ResetTrim}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,12,24,20">
                <TextBlock Style="{StaticResource Title}" Text="SoundSplit" />
                <TextBlock Style="{StaticResource Body}" Text="Play the same sound on several speakers at once, in sync."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />

                <!-- Message bar -->
                <Border x:Name="InfoBar" CornerRadius="4" BorderThickness="1" Padding="14,10,6,10" Margin="0,16,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.None}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.Success}">
                                    <Setter Property="Background" Value="{DynamicResource GoodFill}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.Caution}">
                                    <Setter Property="Background" Value="{DynamicResource CautionFill}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.Error}">
                                    <Setter Property="Background" Value="{DynamicResource BadFill}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,2,12,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xF167;" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.Success}">
                                            <Setter Property="Text" Value="&#xEC61;" />
                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.Caution}">
                                            <Setter Property="Text" Value="&#xF167;" />
                                            <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Bar}" Value="{x:Static vm:BarKind.Error}">
                                            <Setter Property="Text" Value="&#xEB90;" />
                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding BarTitle}" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding BarMessage}" Margin="0,2,0,0" />
                            <Button Content="Open microphone privacy settings" Command="{Binding OpenMicSettings}" Margin="0,8,0,2" HorizontalAlignment="Left"
                                    Visibility="{Binding BarOffersMicSettings, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding DismissBar}" VerticalAlignment="Top" Margin="6,-4,0,0"
                                ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Speakers -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Speakers" />
                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceCard}" Focusable="False" />
                <Border Style="{StaticResource Card}" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="20" Margin="2,0,16,0" />
                        <TextBlock Style="{StaticResource Body}" Text="No speakers or headphones are connected." VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="1,6,0,0">
                    <Hyperlink Command="{Binding OpenSoundSettings}" TextDecorations="{x:Null}">
                        <Run Text="Pair or manage speakers in Windows Settings" />
                    </Hyperlink>
                </TextBlock>

                <!-- Sync -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Sync" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="20" Margin="2,2,16,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Body}" Text="Sync speakers automatically" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding SyncDetail}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="SyncButton" Grid.Column="2" Content="{Binding SyncButtonText}" Command="{Binding Sync}" IsEnabled="{Binding CanSync}"
                                    MinWidth="96" Padding="14,6" Margin="16,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}" Margin="38,12,0,2">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding SyncProgress, Mode=OneWay}" Height="4" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SyncStep}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasMics, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="20" Margin="2,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" Text="Microphone" />
                            <TextBlock Style="{StaticResource Caption}" Text="Only used while syncing. Nothing is recorded or saved." Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Mics}" SelectedItem="{Binding SelectedMic}" DisplayMemberPath="Name"
                                  Width="210" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Microphone" />
                    </Grid>
                </Border>

                <!-- Options -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="When sharing stops" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="20" Margin="2,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" Text="Switch Windows back to its previous speaker" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="While sharing, Windows plays to the slowest speaker so the others can be timed to it." />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RestoreDefault}" Margin="12,0,0,0"
                                  AutomationProperties.Name="Switch Windows back to its previous speaker" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Command bar -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse DataContext="{Binding}" >
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Margin" Value="0,1,8,0" />
                                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterTone}" Value="{x:Static vm:StatusTone.Good}">
                                        <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FooterTone}" Value="{x:Static vm:StatusTone.Caution}">
                                        <Setter Property="Fill" Value="{DynamicResource CautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding FooterText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="ShareButton" Grid.Column="1" Command="{Binding ToggleShare}" IsEnabled="{Binding CanShare}"
                        MinWidth="150" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding ShareGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="{Binding ShareText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
